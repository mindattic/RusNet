<Window x:Class="RusNet.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="RusNet"
        Width="1280" Height="840"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117">
    <!-- No native chrome: the window is nothing but the shared web viewer, so this app is visually
         identical to the Python (pywebview) app. Open and Scan live in the page's own toolbar. -->
    <wv2:WebView2 x:Name="WebView" />
</Window>
